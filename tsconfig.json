{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2024",
        "strict": true,
        "rootDir": ".",
        "outDir": "dist",
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true,
    },
    "exclude": [
        "dist",
        "node_modules"
    ]
}